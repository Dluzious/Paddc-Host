// Konfigurasi Cloudflare Worker untuk Paddoc Host.
// Database D1 "paddoc-host" dibuat otomatis saat deploy pertama (tidak perlu isi database_id).
{
  "name": "paddoc-host",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // file aplikasi (index.html, ikon, config.js); yang tidak perlu ikut diatur di .assetsignore
  "assets": { "directory": ".", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "paddoc-host" }
  ],
  "vars": {
    // model dicoba berurutan; yang kedua dipakai kalau yang pertama tidak tersedia
    "OPENAI_IMAGE_MODEL": "gpt-image-2.5-sunburst,gpt-image-1",
    "OPENAI_IMAGE_QUALITY": "high"
  },
  // APP_PIN dan OPENAI_API_KEY diisi sebagai Secret di dashboard Cloudflare, bukan di file ini
  "observability": { "enabled": true }
}
